# Everything named NEXT_PUBLIC_* is inlined into the JavaScript bundle every
# visitor downloads. Only public values belong here — never the Supabase
# service_role key, which bypasses row-level security entirely.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: needed only for Google sign-in. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
