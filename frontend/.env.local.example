# Everything named NEXT_PUBLIC_* is inlined into the JavaScript bundle every
# visitor downloads. Only public values belong here — never the Supabase
# service_role key, which bypasses row-level security entirely.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: needed only for Google sign-in. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Legal pages (/privacy, /terms, /refunds, /contact) ───────────────────────
# Until name and email are set, each page shows a "Template — not yet in force"
# banner. Payment providers require these pages before activating payments.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_GOVERNING_LAW=
NEXT_PUBLIC_REFUND_WINDOW_DAYS=14
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
# Who hosts this website, named in the privacy policy (e.g. Netlify).
NEXT_PUBLIC_WEBSITE_HOST=
