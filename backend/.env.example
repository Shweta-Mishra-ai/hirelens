# HireLens Backend — Environment Variables
# Copy to .env and fill values — NEVER commit .env to git

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-char-secret-key-change-this-now

# ── CORS — your frontend URLs ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Supabase (supabase.com — free tier) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key — KEEP SECRET
SUPABASE_ANON_KEY=eyJ...      # anon/public key

# ── LLM APIs (at least one required) ─────────────────────────────────────────
# Gemini 2.5 Flash — PRIMARY (free at aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# Groq — FALLBACK (free at console.groq.com)
GROQ_API_KEY=gsk_...

# Anthropic — OPTIONAL FALLBACK (paid)
ANTHROPIC_API_KEY=sk-ant-...

# ── Redis (upstash.com — free tier, optional) ─────────────────────────────────
REDIS_URL=rediss://[HOST]:6379
REDIS_PASSWORD=your-redis-password

# Feature 3 — Public Data Verification
# Optional but recommended: raises GitHub API limit from 60/hr to 5000/hr.
# Free — generate at https://github.com/settings/tokens (no scopes needed, "public_repo" read is enough)
GITHUB_TOKEN=

# ── Email (optional — candidate decisions and team invites) ───────────────────
# Resend is tried first, then SMTP. With neither, sends report as not sent
# rather than failing the request.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Used in the invite links that go out in those emails.
FRONTEND_URL=http://localhost:3000

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=20
NOTIFY_RATE_LIMIT_PER_MINUTE=10
ANALYSIS_TIMEOUT_SECONDS=120
