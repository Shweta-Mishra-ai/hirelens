# HireLens Backend — Environment Variables
# Copy to .env and fill values — NEVER commit .env to git

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Signs every session token. REQUIRED in production — the app refuses to start
# without at least 32 characters, because a guessable value lets anyone mint a
# valid session.
#
# Leave it blank for local development and one is generated for you, once, into
# backend/data/.dev-secret (gitignored). There is deliberately no default in
# the source: a shipped constant would be a single publicly known signing key
# shared by every install that forgot to set one.
#
# Generate for production: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── CORS — your frontend URLs ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Supabase (supabase.com — free tier) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key — KEEP SECRET
SUPABASE_ANON_KEY=eyJ...      # anon/public key

# ── LLM APIs (at least one required) ─────────────────────────────────────────
# Gemini — PRIMARY (free tier at aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# Groq — FALLBACK (free at console.groq.com)
GROQ_API_KEY=gsk_...

# Anthropic — OPTIONAL FALLBACK (paid)
ANTHROPIC_API_KEY=sk-ant-...

# Model names. Providers retire models on a schedule; a retired name fails every
# call, so these are configuration rather than code.
# Ordered fallback list. Both are on the free tier. Do not use gemini-2.5-*:
# since Sept 2026 Google serves those only to projects that used them before.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Gemini 3.x thinking: minimal | low | medium | high, or empty for the default.
GEMINI_THINKING_LEVEL=low
# llama-3.3-70b-versatile was shut down for free keys on 16 Aug 2026.
GROQ_MODEL=openai/gpt-oss-120b
# Which provider sees resumes first. On Gemini's FREE tier Google may use
# submitted content to improve its products; Groq does not train on API data.
# Until Gemini billing is enabled, prefer: groq,gemini,anthropic
LLM_PROVIDER_ORDER=gemini,groq,anthropic
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Redis (upstash.com — free tier, optional) ─────────────────────────────────
REDIS_URL=rediss://[HOST]:6379
REDIS_PASSWORD=your-redis-password

# Feature 3 — Public Data Verification
# Optional but recommended: raises GitHub API limit from 60/hr to 5000/hr.
# Free — generate at https://github.com/settings/tokens (no scopes needed, "public_repo" read is enough)
GITHUB_TOKEN=

# ── Email (optional — candidate decisions and team invites) ───────────────────
# Resend is tried first, then SMTP. With neither, sends report as not sent
# rather than failing the request.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Used in the invite links that go out in those emails.
FRONTEND_URL=http://localhost:3000

# ── Operators ─────────────────────────────────────────────────────────────────
# Sign-in emails allowed to read /health/diagnostics and /auth/stats and to
# change a customer's plan. In production nobody can until this is set.
ADMIN_EMAILS=

# ── Plans and quotas ──────────────────────────────────────────────────────────
# Completed analyses per calendar month on each plan. 0 = unlimited (default).
FREE_MONTHLY_ANALYSES=0
PRO_MONTHLY_ANALYSES=0
TEAM_MONTHLY_ANALYSES=0
# Where the in-app "Upgrade" button goes: a payment link, pricing page or mailto:.
UPGRADE_URL=
# UPI payments verified by an operator (sql/010). Off while PAYMENT_UPI_ID is
# empty. A plan is for sale when its price, in whole rupees, is above 0.
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=
PRO_PRICE_INR=0
TEAM_PRICE_INR=0
PLAN_PERIOD_DAYS=30
# Hard ceiling on registered accounts. 0 = none.
MAX_REGISTERED_USERS=5000

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
# How many proxies sit in front of this app. Rate limits are keyed on the
# client IP, which behind a proxy comes from X-Forwarded-For — a header the
# caller also sets. Only this many entries from the right are trusted.
#   1  Render, Vercel, most single-proxy setups (default)
#   2  Cloudflare in front of one of those
#   0  running uvicorn directly, e.g. local development
TRUSTED_PROXY_HOPS=1

RATE_LIMIT_PER_MINUTE=20
NOTIFY_RATE_LIMIT_PER_MINUTE=10
ANALYSIS_TIMEOUT_SECONDS=120

# How long one bulk batch may hold a concurrent-batch slot before the slot is
# treated as abandoned and given back. A batch that dies with its container —
# a deploy, or a free-tier instance going to sleep — never hands its slot back
# on its own, and without this a user would be locked out of bulk upload.
# Must stay above the worst-case runtime of a full batch:
# ceil(BULK_MAX_FILES / BULK_CONCURRENCY) x ANALYSIS_TIMEOUT_SECONDS.
BATCH_LEASE_SECONDS=2700
